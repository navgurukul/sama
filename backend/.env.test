# Isolated Testing Database (Uses local SQLite for fast, safe tests)
DATABASE_URL=sqlite:///./test.db
DB_SCHEMA=sama_ops
ENABLE_BACKGROUND_JOBS=false

# Dummy AWS S3 Configuration (Prevents tests from modifying real AWS files)
AWS_ACCESS_KEY_ID=test_access_key
AWS_SECRET_ACCESS_KEY=test_secret_key
AWS_REGION=ap-south-1
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/TestRole
S3_BUCKET=test-bucket

# Dummy SMTP Configuration (Prevents tests from sending real emails)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test_user
SMTP_PASSWORD=test_password
SMTP_SENDER=test@thesama.in
MAILJET_SENDER_NAME=Test Sender

# System Configuration
SAMA_OPS_EMAIL=test_ops@thesama.in
AMAZON_AFE_EMAIL=
RMS_INACTIVITY_LIMIT_DAYS=30
QUARTERLY_IMPACT_JOTFORM_URL=https://test.jotform.com

# Dummy AI Tools Configuration
MISTRAL_API_KEY=test_mistral_key
MISTRAL_MODEL=mistral-medium-3-5
